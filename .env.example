PORT=5001
NODE_ENV=development

# Dual-Cluster MongoDB Atlas Setup (Project 1 = mainDb, Project 2 = msgDb)
MONGO_MAIN_URI=mongodb+srv://<username>:<password>@<cluster1>.mongodb.net/chat_main?retryWrites=true&w=majority
MONGO_MSG_URI=mongodb+srv://<username>:<password>@<cluster2>.mongodb.net/chat_messages?retryWrites=true&w=majority

# Redis Cloud TCP Backplane
REDIS_URL=redis://default:<redis_password>@clam-wisplike-afterthought-44666.db.redis.io:12707

# JWT Auth
JWT_SECRET=change_this_to_a_strong_random_secret_key
JWT_EXPIRES_IN=24h

# Frontend Origin (for CORS & Socket.io)
CLIENT_URL=http://localhost:4200
